{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": [
        "overall_risk",
        "block_merge",
        "findings"
    ],
    "properties": {
        "audit_id": {
            "type": "string"
        },
        "overall_risk": {
            "type": "string",
            "enum": [
                "CRITICAL",
                "HIGH",
                "MEDIUM",
                "LOW",
                "PASS",
                "UNCERTAIN",
                "ERROR"
            ]
        },
        "block_merge": {
            "type": "boolean"
        },
        "summary": {
            "type": "string"
        },
        "findings": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "severity",
                    "resource",
                    "description",
                    "remediation"
                ],
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "severity": {
                        "type": "string",
                        "enum": [
                            "CRITICAL",
                            "HIGH",
                            "MEDIUM",
                            "LOW"
                        ]
                    },
                    "resource": {
                        "type": "string"
                    },
                    "category": {
                        "type": "string"
                    },
                    "cis_control": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "remediation": {
                        "type": "string"
                    }
                }
            }
        }
    }
}